# =============================================================================
#  VFM — pnpm konfiguracija
# =============================================================================
# Stroga izolacija dependencija (hoisting samo unutar node_modules/.pnpm)
node-linker=isolated

# pnpm 10: ne izvršavaj postinstall skripte dependencija bez eksplicitne dozvole
# (dozvole su u pnpm-workspace.yaml: onlyBuiltDependencies / ignoredBuiltDependencies)
strict-peer-dependencies=false
auto-install-peers=true

# Reproducibilni install
resolution-mode=highest
save-workspace-protocol=rolling

# Mreža
fetch-retries=3
fetch-retry-maxtimeout=60000
fetch-timeout=300000
