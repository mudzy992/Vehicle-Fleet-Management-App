{
  "name": "@vfm/form-engine",
  "version": "1.0.0",
  "private": true,
  "description": "VFM — form engine: meta-shema definicije, rezervisani ključevi, kanonski hash, sigurni izrazi (Faza 2)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@vfm/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vfm/config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "@eslint/js": "9.39.5",
    "eslint-config-prettier": "10.1.8"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definition": {
      "types": "./dist/definition.schema.d.ts",
      "default": "./dist/definition.schema.js"
    }
  },
  "typesVersions": {
    "*": {
      "definition": [
        "./dist/definition.schema.d.ts"
      ]
    }
  }
}
