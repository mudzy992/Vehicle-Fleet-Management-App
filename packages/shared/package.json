{
  "name": "@vfm/shared",
  "version": "1.0.0",
  "private": true,
  "description": "VFM — dijeljeni tipovi, konstante, katalog grešaka, permisije i formatiranje (bs)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage .turbo",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vfm/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env-schema.d.ts",
      "default": "./dist/env-schema.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "typesVersions": {
    "*": {
      "env": [
        "./dist/env-schema.d.ts"
      ],
      "schemas": [
        "./dist/schemas.d.ts"
      ]
    }
  }
}
