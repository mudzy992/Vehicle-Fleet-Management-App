  notes          String?
  formData       Json          @default("{}")
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)

  set TireSet? @relation(fields: [setId], references: [id], onDelete: SetNull)
  // SQL: partial unique (setId, position) WHERE setId IS NOT NULL AND deletedAt IS NULL.

  @@index([status])
  @@index([setId])
  @@map("Tire")
}

model TireInstallation {
  id                        String         @id @db.Uuid
  setId                     String         @db.Uuid
  vehicleId                 String         @db.Uuid
  mountedAt                 DateTime       @db.Date
  mountedOdometerKm         Int
  dismountedAt              DateTime?      @db.Date
  dismountedOdometerKm      Int?
  reason                    String?
  positions                 TirePosition[]
  storageLocationOnDismount String?
  daysInUse                 Int?
  kmDriven                  Int?
  formSchemaId              String?        @db.Uuid
  formSchemaVersionId       String?        @db.Uuid
  formData                  Json           @default("{}")
  version                   Int            @default(0)
  createdById               String?        @db.Uuid
  createdAt                 DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt                 DateTime?      @db.Timestamptz(6)

  set               TireSet            @relation(fields: [setId], references: [id], onDelete: Cascade)
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  formSchema        FormSchema?        @relation(fields: [formSchemaId], references: [id])
  formSchemaVersion FormSchemaVersion? @relation(fields: [formSchemaVersionId], references: [id])
  // SQL (B-09, ključno za P-13):
  //   CREATE UNIQUE INDEX ux_tire_installation_active ON "TireInstallation"("setId")
  //     WHERE "dismountedAt" IS NULL AND "deletedAt" IS NULL;
  //   CHECK (dismountedAt IS NULL OR dismountedAt >= mountedAt)
  //   CHECK (dismountedOdometerKm IS NULL OR dismountedOdometerKm >= mountedOdometerKm)

  @@index([vehicleId, mountedAt(sort: Desc)])
  @@index([setId, mountedAt(sort: Desc)])
  @@map("TireInstallation")
}

// -----------------------------------------------------------------------------
//  3.5 Forme (dinamičke šeme, verzionisane)
// -----------------------------------------------------------------------------

model FormSchema {
  id                        String      @id @db.Uuid
  key                       String      @unique
  name                      String
  subject                   FormSubject
  taskTypeId                String?     @db.Uuid
  description               String?
  status                    String      @default("ACTIVE")
  currentPublishedVersionId String?     @db.Uuid
  ownerModule               String?
  createdById               String?     @db.Uuid
  createdAt                 DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt                 DateTime?   @db.Timestamptz(6)

  taskType                TaskType?            @relation("TaskTypeFormSchemas", fields: [taskTypeId], references: [id])
  defaultForTaskTypes     TaskType[]           @relation("TaskTypeDefaultFormSchema")
  versions                FormSchemaVersion[]
  currentPublishedVersion FormSchemaVersion?   @relation("CurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id])
  migrationJobs           FormMigrationJob[]
  vehicles                Vehicle[]
  registrationRecords     RegistrationRecord[]
  insuranceRecords        InsuranceRecord[]
  serviceRecords          ServiceRecord[]
  drivers                 Driver[]
  tireSets                TireSet[]
  tireInstallations       TireInstallation[]
  tasks                   Task[]
  // SQL: partial unique (subject, taskTypeId) WHERE subject='TASK' AND deletedAt IS NULL.

  @@index([subject])
  @@map("FormSchema")
}

model FormSchemaVersion {
  id               String           @id @db.Uuid
  formSchemaId     String           @db.Uuid
  version          Int
  status           FormSchemaStatus @default(DRAFT)
  definition       Json
  contentHash      String?
  changeNote       String?
  publishedAt      DateTime?        @db.Timestamptz(6)
  publishedById    String?          @db.Uuid
  retiredAt        DateTime?        @db.Timestamptz(6)
  retiredById      String?          @db.Uuid
  normalizedName   Json?
  compatibility    Json?
  mobileCompatible Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  createdById      String?          @db.Uuid

  formSchema         FormSchema         @relation(fields: [formSchemaId], references: [id], onDelete: Cascade)
  publishedVersionOf FormSchema[]       @relation("CurrentPublishedVersion")
  migrationJobsFrom  FormMigrationJob[] @relation("MigrationFromVersion")
  migrationJobsTo    FormMigrationJob[] @relation("MigrationToVersion")

  // Zapisi koji nose `formSchemaVersionId` (U-02: svaki zapis pamti tačnu
  // objavljenu verziju forme kojom je unesen — verzija je immutable, P-10).
  vehicles            Vehicle[]
  registrationRecords RegistrationRecord[]
  insuranceRecords    InsuranceRecord[]
  serviceRecords      ServiceRecord[]
  drivers             Driver[]
  tireSets            TireSet[]
  tireInstallations   TireInstallation[]
  tasks               Task[]
  // IMMUTABILNOST (P-10): DB trigger odbija UPDATE (definition/version/status→DRAFT)
  //   i DELETE kada je status='PUBLISHED'. Dozvoljen samo prelaz PUBLISHED→RETIRED.
  // SQL: CHECK (version > 0).

  @@unique([formSchemaId, version])
  @@index([formSchemaId, status, publishedAt(sort: Desc)])
  @@map("FormSchemaVersion")
}

model FieldKeyRegistry {
  id                  String   @id @db.Uuid
  key                 String   @unique
  dataType            String
  unit                String?
  normalizedColumn    String?
  usedByFormSchemaIds String[] @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
  // U-16: isti ključ = isti tip i značenje u svim formama.
  // RESERVED_FIELD_KEY greška se baca kad forma pokuša koristiti rezervisani ključ.

  @@map("FieldKeyRegistry")
}

model FormMigrationJob {
  id               String             @id @db.Uuid
  formSchemaId     String             @db.Uuid
  fromVersionId    String             @db.Uuid
  toVersionId      String             @db.Uuid
  targetEntityType String
  targetEntityIds  String[]           @db.Uuid
  filter           Json?
  status           MigrationJobStatus @default(PENDING)
  previewResult    Json?
  requestedById    String?            @db.Uuid
  startedAt        DateTime?          @db.Timestamptz(6)
  finishedAt       DateTime?          @db.Timestamptz(6)
  summary          Json?
  notes            String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)

  formSchema  FormSchema          @relation(fields: [formSchemaId], references: [id], onDelete: Cascade)
  fromVersion FormSchemaVersion   @relation("MigrationFromVersion", fields: [fromVersionId], references: [id])
  toVersion   FormSchemaVersion   @relation("MigrationToVersion", fields: [toVersionId], references: [id])
  items       FormMigrationItem[]

  @@index([status, createdAt])
  @@map("FormMigrationJob")
}

model FormMigrationItem {
  id          String    @id @db.Uuid
  jobId       String    @db.Uuid
  entityId    String    @db.Uuid
  before      Json?
  after       Json?
  status      String    @default("PENDING")
  error       String?
  processedAt DateTime? @db.Timestamptz(6)

  job FormMigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, entityId])
  @@map("FormMigrationItem")
}

// -----------------------------------------------------------------------------
//  3.6 Zadaci
// -----------------------------------------------------------------------------

model TaskType {
  id                     String         @id @db.Uuid
  code                   String         @unique
  name                   String
  description            String?
  iconName               String?
  colorHex               String?
  requiresVehicle        Boolean        @default(true)
  requiresOdometer       Boolean        @default(false)
  requiresPhotos         Boolean        @default(false)
  defaultPriority        TaskPriority   @default(NORMAL)
  defaultAssignMode      TaskAssignMode @default(OPEN_CLAIM)
  allowMultipleClaimants Boolean        @default(false)
  dueOffsetHours         Int?
  formSchemaId           String?        @db.Uuid
  active                 Boolean        @default(true)
  sortOrder              Int            @default(100)
  createdById            String?        @db.Uuid
  createdAt              DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?      @db.Timestamptz(6)

  // Dvije NEZAVISNE relacije između TaskType i FormSchema (Prisma traži imena):
  //  - formSchema  = zadana/aktivna forma za ovaj tip zadatka (FK na TaskType strani)
  //  - formSchemas = sve forme čiji je `taskTypeId` ovaj tip (FK na FormSchema strani)
  formSchema             FormSchema?                 @relation("TaskTypeDefaultFormSchema", fields: [formSchemaId], references: [id])
  formSchemas            FormSchema[]                @relation("TaskTypeFormSchemas")
  tasks                  Task[]
  completionRequirements TaskCompletionRequirement[]
  // Seed: WASH, INTERIOR_CLEANING, FUEL_REFILL, SERVICE_VISIT, TIRE_CHANGE,
  //       TECHNICAL_INSPECTION, REGISTRATION, CUSTOM.

  @@map("TaskType")
}

model Task {
  id                  String         @id @db.Uuid
  code                String         @unique
  title               String
  description         String?
  vehicleId           String?        @db.Uuid
  taskTypeId          String         @db.Uuid
  priority            TaskPriority   @default(NORMAL)
  status              TaskStatus     @default(OPEN)
  assignMode          TaskAssignMode @default(OPEN_CLAIM)
  createdById         String         @db.Uuid
  assigneeUserId      String?        @db.Uuid
  claimedAt           DateTime?      @db.Timestamptz(6)
  completedAt         DateTime?      @db.Timestamptz(6)
  completedById       String?        @db.Uuid
  dueAt               DateTime?      @db.Timestamptz(6)
  dueDate             DateTime?      @db.Date
  cancelledAt         DateTime?      @db.Timestamptz(6)
  cancelReason        String?
  reopenedAt          DateTime?      @db.Timestamptz(6)
  releasedAt          DateTime?      @db.Timestamptz(6)
  durationMinutes     Int?
  odometerKm          Int?
  totalCost           Int?
  fuelLiters          Decimal?       @db.Decimal(10, 2)
  fuelAmount          Int?
  fuelConsumptionL100 Decimal?       @db.Decimal(6, 2)
  formSchemaId        String         @db.Uuid
  formSchemaVersionId String         @db.Uuid
  formData            Json           @default("{}")
  version             Int            @default(0)
  idempotencyKey      String?
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?      @db.Timestamptz(6)

  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id])
  taskType          TaskType          @relation(fields: [taskTypeId], references: [id])
  createdBy         User              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignee          User?             @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  formSchema        FormSchema        @relation(fields: [formSchemaId], references: [id])
  formSchemaVersion FormSchemaVersion @relation(fields: [formSchemaVersionId], references: [id])
  assignments       TaskAssignment[]
  events            TaskEvent[]
  comments          TaskComment[]
  attachments       Attachment[]      @relation("TaskAttachments")
  // SQL:
  //   CHECK (status <> 'COMPLETED' OR (assigneeUserId IS NOT NULL AND completedAt IS NOT NULL))
  //   CHECK (status <> 'IN_PROGRESS' OR assigneeUserId IS NOT NULL)
  //   CHECK (odometerKm IS NULL OR odometerKm >= 0)
  //   partial unique na idempotencyKey (WHERE idempotencyKey IS NOT NULL)
  //
  // ATOMSKI CLAIM (P-04) — jedan izvršilac pod konkurencijom:
  //   UPDATE "Task" SET "status"='IN_PROGRESS', "claimedAt"=now(),
  //          "version"="version"+1
  //   WHERE "id"=$1 AND "status"='OPEN' AND "deletedAt" IS NULL
  //   RETURNING "id","version";
  //   → prazan RETURNING = 409 TASK_ALREADY_CLAIMED.

  @@index([status, dueAt])
  @@index([vehicleId, createdAt(sort: Desc)])
  @@index([assigneeUserId, status])
  @@index([taskTypeId, status])
  @@index([createdById, createdAt(sort: Desc)])
  @@map("Task")
}

model TaskAssignment {
  id           String    @id @db.Uuid
  taskId       String    @db.Uuid
  userId       String    @db.Uuid
  role         String    @default("INVITED")
  assignedById String?   @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  note         String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SQL (drugi pojas za P-04):
  //   CREATE UNIQUE INDEX ux_task_assignment_assignee ON "TaskAssignment"("taskId")
  //     WHERE role='ASSIGNEE' AND "revokedAt" IS NULL;
  //   CHECK (role IN ('INVITED','ASSIGNEE','OBSERVER'))

  @@unique([taskId, userId, role])
  @@index([userId])
  @@map("TaskAssignment")
}

model TaskEvent {
  id                  String          @id @db.Uuid
  taskId              String          @db.Uuid
  action              TaskEventAction
  actorId             String?         @db.Uuid
  actorRole           String?
  at                  DateTime        @default(now()) @db.Timestamptz(6)
  ipAddress           String?         @db.Inet
  clientType          ClientType?
  requestId           String?
  data                Json?
  formSchemaVersionId String?         @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])
  // IMMUTABILAN: bez updatedAt/deletedAt + DB trigger koji odbija UPDATE/DELETE.

  @@index([taskId, at])
  @@index([actorId, at])
  @@map("TaskEvent")
}

model TaskComment {
  id              String    @id @db.Uuid
  taskId          String    @db.Uuid
  authorId        String    @db.Uuid
  body            String
  mentionsUserIds String[]  @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
  @@map("TaskComment")
}

model TaskCompletionRequirement {
  id         String          @id @db.Uuid
  taskTypeId String          @db.Uuid
  fieldKey   String
  required   Boolean         @default(true)
  stage      AttachmentStage @default(GENERAL)
  minPhotos  Int             @default(0)

  taskType TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  // U-13: npr. obavezna fotografija "prije i poslije" za pranje vozila.

  @@unique([taskTypeId, fieldKey])
  @@map("TaskCompletionRequirement")
}

// -----------------------------------------------------------------------------
//  3.7 Outbox i obavijesti
// -----------------------------------------------------------------------------

model OutboxEvent {
  id             String       @id @db.Uuid
  aggregateType  String
  aggregateId    String       @db.Uuid
  eventType      String
  payload        Json
  idempotencyKey String       @unique
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?
  lockedAt       DateTime?    @db.Timestamptz(6)
  lockedBy       String?
  availableAt    DateTime     @default(now()) @db.Timestamptz(6)
  processedAt    DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  notifications Notification[]
  // P-05: upis u ISTOJ transakciji kao domenska promjena; worker ga prenosi u
  //   BullMQ (`vfm-queue-outbox`) i označi PROCESSED/FAILED/DEAD.
  // SQL: partial index WHERE status IN ('PENDING','FAILED').
  // Retencija PROCESSED: 30 dana.

  @@index([status, availableAt])
  @@map("OutboxEvent")
}

model Notification {
  id              String             @id @db.Uuid
  userId          String             @db.Uuid
  type            String
  title           String
  body            String?
  data            Json?
  linkToType      String?
  linkToId        String?            @db.Uuid
  priority        String             @default("NORMAL")
  status          NotificationStatus @default(PENDING)
  isRead          Boolean            @default(false)
  inAppVisible    Boolean            @default(true)
  readAt          DateTime?          @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  sentAt          DateTime?          @db.Timestamptz(6)
  outboxEventId   String?            @db.Uuid
  notificationKey String             @unique
  dedupeKey       String             @unique
  expiresAt       DateTime?          @db.Timestamptz(6)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outboxEvent OutboxEvent?           @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)
  deliveries  NotificationDelivery[]
  // B-13: dedupeKey = "{type}:{linkToType}:{linkToId}:{bucket}" → tačno jedna
  //   in-app obavijest po događaju.

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, inAppVisible, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("Notification")
}

model NotificationDelivery {
  id                String         @id @db.Uuid
  notificationId    String         @db.Uuid
  channel           String
  deviceTokenId     String?        @db.Uuid
  status            DeliveryStatus @default(QUEUED)
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  attempts          Int            @default(0)
  availableAt       DateTime       @default(now()) @db.Timestamptz(6)
  lockedAt          DateTime?      @db.Timestamptz(6)
  lockedBy          String?
  sentAt            DateTime?      @db.Timestamptz(6)
  deliveredAt       DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceToken  DeviceToken? @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  // SQL: CHECK (channel IN ('FCM','SSE','EMAIL','IN_APP')).

  @@unique([notificationId, channel, deviceTokenId])
  @@index([notificationId])
  @@index([status, createdAt])
  @@index([status, availableAt])
  @@map("NotificationDelivery")
}

model DeviceToken {
  id           String            @id @db.Uuid
  userId       String            @db.Uuid
  token        String
  tokenHash    String            @unique
  platform     String            @default("android")
  appVersion   String?
  deviceModel  String?
  osVersion    String?
  locale       String?
  status       DeviceTokenStatus @default(ACTIVE)
  lastSeenAt   DateTime?         @db.Timestamptz(6)
  lastError    String?
  failureCount Int               @default(0)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime?         @db.Timestamptz(6)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]
  // Sirovi token je potreban za FCM slanje; API ga nikad ne vraća, tokenHash služi deduplikaciji.
  // FCM (R-04): Firebase projekat kreira vlasnik ručno; do tada
  //   FIREBASE_ENABLED=false i push se ne šalje.

  @@index([userId, status])
  @@map("DeviceToken")
}

model NotificationPreference {
  id              String    @id @db.Uuid
  userId          String    @db.Uuid
  type            String
  channelFcm      Boolean   @default(true)
  channelInApp    Boolean   @default(true)
  channelEmail    Boolean   @default(false)
  // docs/03: PostgreSQL TIME. Prisma uz `@db.Time` dozvoljava SAMO `DateTime`,
  // pa se vraća Date s datumom 1970-01-01 — značajan je samo HH:MM:SS dio
  // (lokalno vrijeme Europe/Sarajevo, ne UTC instanta).
  quietHoursStart DateTime? @db.Time
  quietHoursEnd   DateTime? @db.Time
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("NotificationPreference")
}

// -----------------------------------------------------------------------------
//  3.8 Podsjetnici
// -----------------------------------------------------------------------------

model ReminderPolicy {
  id                   String       @id @db.Uuid
  kind                 ReminderKind @unique
  enabled              Boolean      @default(true)
  thresholdsDays       Int[]        @default([5])
  thresholdsKm         Int[]        @default([])
  recipientsPermission String       @default("vehicle:view")
  recipientRoleIds     String[]     @db.Uuid
  channels             String[]     @default(["IN_APP", "FCM"])
  escalate             Boolean      @default(false)
  notes                String?
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  scheduledReminders ScheduledReminder[]

  @@map("ReminderPolicy")
}

model ScheduledReminder {
  id               String         @id @db.Uuid
  policyId         String         @db.Uuid
  kind             ReminderKind
  entityType       String
  entityId         String         @db.Uuid
  dueDate          DateTime?      @db.Date
  dueKm            Int?
  thresholdDays    Int?
  thresholdKm      Int?
  fireAt           DateTime       @db.Timestamptz(6)
  status           ReminderStatus @default(SCHEDULED)
  dedupeKey        String         @unique
  sentAt           DateTime?      @db.Timestamptz(6)
  acknowledgedById String?        @db.Uuid
  acknowledgedAt   DateTime?      @db.Timestamptz(6)
  outboxEventId    String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)

  policy         ReminderPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  acknowledgedBy User?          @relation("ReminderAcknowledgedBy", fields: [acknowledgedById], references: [id])
  // P-07 (idempotentnost): dedupeKey = "{kind}:{entityType}:{entityId}:{dueDate|dueKm}:{threshold}"
  //   → tačno jedan podsjetnik po (zapis, vrsta, prag).
  // Računanje `fireAt` ide u Europe/Sarajevo (N-11), čuva se u UTC.

  @@index([status, fireAt])
  @@map("ScheduledReminder")
}

// -----------------------------------------------------------------------------
//  3.9 Prilozi
// -----------------------------------------------------------------------------

model Attachment {
  id           String              @id @db.Uuid
  ownerId      String              @db.Uuid
  ownerType    AttachmentOwnerType
  stage        AttachmentStage     @default(GENERAL)
  fileName     String
  storageKey   String              @unique
  mimeType     String
  ext          String
  sizeBytes    BigInt
  sha256       String
  width        Int?
  height       Int?
  exifStripped Boolean             @default(true)
  uploadedById String              @db.Uuid
  taskId       String?             @db.Uuid
  formFieldKey String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  deletedAt    DateTime?           @db.Timestamptz(6)

  uploadedBy     User        @relation(fields: [uploadedById], references: [id])
  task           Task?       @relation("TaskAttachments", fields: [taskId], references: [id])
  exportJobs     ExportJob[]
  // 1:1 "glavna fotografija" — FK je na strani Vehicle/Driver (`photoAttachmentId`),
  // pa suprotna strana ovdje nema polja s FK-om (B-15: attachment je vlasništvo
  // entiteta preko `ownerType`/`ownerId`, ovo su samo pokazivači na naslovnicu).
  vehiclePhotoOf Vehicle?    @relation("VehiclePhoto")
  driverPhotoOf  Driver?     @relation("DriverPhoto")
  // B-15: fajl se NIKAD ne servira direktno s diska — isključivo
  //   GET /attachments/:id/content uz permisiju + potpisani URL.
  // Pohrana: host bind-mount /data/vfm/attachments (odluka vlasnika).

  @@unique([ownerType, ownerId, sha256])
  @@index([sha256])
  @@index([uploadedById, createdAt])
  @@index([deletedAt])
  @@map("Attachment")
}

// -----------------------------------------------------------------------------
//  3.10 Audit, postavke, šifarnici, izvještaji
// -----------------------------------------------------------------------------

model AuditLog {
  id            BigInt        @id @default(autoincrement())
  actorId       String?       @db.Uuid
  actorEmail    String?
  actorRoles    String[]
  action        AuditAction
  severity      AuditSeverity @default(INFO)
  entityType    String?
  entityId      String?       @db.Uuid
  entityCode    String?
  before        Json?
  after         Json?
  changedFields String[]
  reason        String?
  requestId     String?
  ipAddress     String?       @db.Inet
  userAgent     String?
  clientType    ClientType?
  metadata      Json?
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id])
  // IMMUTABILAN: DB trigger odbija UPDATE/DELETE. Retencija: AUDIT_RETENTION_DAYS.

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@map("AuditLog")
}

model Setting {
  id          String      @id @db.Uuid
  key         String      @unique
  value       Json
  type        SettingType
  valueSchema Json?       @map("schema")
  category    String?
  isSecret    Boolean     @default(false)
  isPublic    Boolean     @default(false)
  description String?
  updatedById String?     @db.Uuid
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  @@index([category])
  @@map("Setting")
}

model List {
  id          String   @id @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  items ListItem[]

  @@map("List")
}

model ListItem {
  id        String    @id @db.Uuid
  listId    String    @db.Uuid
  code      String?
  label     String
  value     Json?
  sortOrder Int       @default(100)
  active    Boolean   @default(true)
  parentId  String?   @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  list           List            @relation(fields: [listId], references: [id], onDelete: Cascade)
  parent         ListItem?       @relation("ListItemHierarchy", fields: [parentId], references: [id])
  children       ListItem[]      @relation("ListItemHierarchy")
  serviceRecords ServiceRecord[]

  @@unique([listId, code])
  @@index([listId, sortOrder])
  @@map("ListItem")
}

model IdempotencyKey {
  id             String   @id @db.Uuid
  key            String
  userId         String   @db.Uuid
  method         String?
  path           String?
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // P-06: TTL 24 h (IDEMPOTENCY_TTL_HOURS); maintenance job čisti istekle.

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("IdempotencyKey")
}

model ReportDefinition {
  id                 String   @id @db.Uuid
  code               String   @unique
  name               String
  category           String   @default("GENERAL")
  sourceView         String
  columns            Json?
  defaultFilters     Json?
  requiredPermission String
  isSystem           Boolean  @default(false)
  sortOrder          Int      @default(100)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  exportJobs ExportJob[]
  // sourceView: jedan od `vfm_v_*` view-ova (docs/03 §4) — čitaju samo
  //   normalizovane kolone, nikad formData JSONB (U-03).

  @@map("ReportDefinition")
}

model ExportJob {
  id                 String       @id @db.Uuid
  reportDefinitionId String       @db.Uuid
  format             ExportFormat
  filters            Json?
  status             ExportStatus @default(QUEUED)
  requestedById      String?      @db.Uuid
  rowCount           Int?
  attachmentId       String?      @db.Uuid
  errorMessage       String?
  startedAt          DateTime?    @db.Timestamptz(6)
  finishedAt         DateTime?    @db.Timestamptz(6)
  expiresAt          DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)

  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id])
  requestedBy      User?            @relation(fields: [requestedById], references: [id])
  attachment       Attachment?      @relation(fields: [attachmentId], references: [id])
  // P-13: PDF/XLSX/CSV kroz red `vfm-queue-reports`; Download centar u web UI-u.

  @@index([requestedById, createdAt(sort: Desc)])
  @@index([status])
  @@map("ExportJob")
}
