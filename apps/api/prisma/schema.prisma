// =============================================================================
//  VFM — Prisma šema (izvor istine za model podataka)
// =============================================================================
//  Specifikacija: docs/03-MODEL_PODATAKA.md (entiteti, indeksi, CHECK-ovi,
//                 EXCLUDE ograničenja, triggeri, view-ovi)
//  Baza:          PostgreSQL 17 (globalni Postgres na mreži `db_net`)
//  ORM:           Prisma 7.10
//
//  🔴 PRISMA 7 (7.10.1) — breaking changes koji se tiču ovog fajla:
//       - `url` NIJE dozvoljen u `datasource` bloku (greška P1012); connection
//         URL za CLI živi u `apps/api/prisma.config.ts`,
//       - Prisma 7 NE učitava `.env` sama (config radi `import 'dotenv/config'`),
//       - `migrate dev` više NE pokreće `prisma generate` ni seed automatski.
//     `prisma`, `@prisma/client` i `dotenv` JESU u `apps/api/package.json`.
//     U sandboxu u kojem je ovaj kod nastao `binaries.prisma.sh` nije dostupan,
//     pa tamo rade samo `prisma validate` i `prisma format` (WASM, bez enginea);
//     `generate` i `migrate` pokreću se na mašini/build serveru s internetom:
//       pnpm --filter @vfm/api prisma:generate
//       pnpm --filter @vfm/api exec prisma migrate dev --name init
//     Detalji: apps/api/prisma/README.md
//
//  ⚠️ Sve što Prisma ne može izraziti (CHECK, EXCLUDE USING gist, partial unique
//     index, DB trigger, identity kolona, view) dodaje se RUČNO u SQL migraciju
//     nakon `prisma migrate diff` — idempotentno (`IF NOT EXISTS`,
//     `CREATE OR REPLACE`). Takva mjesta su ovdje označena komentarom `// SQL:`
//     (19 takvih markera — `grep -n "// SQL:" prisma/schema.prisma`).
// =============================================================================

datasource db {
  provider = "postgresql"
  // Prisma 7: bez `url` (P1012). Connection URL čita CLI iz
  // `apps/api/prisma.config.ts` → `datasource.url` (process.env.DATABASE_URL).
  // Runtime (PrismaClient) URL se postavlja pri konstrukciji klijenta.
}

generator client {
  // ⚠️ `prisma-client-js` je u Prisma 7 deprecated (i dalje radi, ali će biti
  //    uklonjen u nekoj od sljedećih verzija). Prelazak na Rust-free generator
  //    `prisma-client` (TS output u repo + driver adapter `@prisma/adapter-pg`)
  //    zaseban je korak i radi se kad `PrismaService` bude implementiran —
  //    vidi apps/api/prisma/README.md §"Prisma 7 — otvorene stavke".
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

