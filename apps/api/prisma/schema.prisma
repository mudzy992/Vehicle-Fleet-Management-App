// -----------------------------------------------------------------------------
//  3.1 Identitet i prava
// -----------------------------------------------------------------------------

model User {
  id                 String     @id @db.Uuid
  email              String     @db.Citext
  passwordHash       String
  firstName          String
  lastName           String
  displayName        String?
  phone              String?
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  tokenVersion       Int        @default(0)
  lastLoginAt        DateTime?  @db.Timestamptz(6)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.Timestamptz(6)
  timezone           String     @default("Europe/Sarajevo")
  locale             String     @default("bs")
  createdById        String?    @db.Uuid
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?  @db.Timestamptz(6)

  createdBy             User?                    @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers          User[]                   @relation("UserCreatedBy")
  roles                 UserRole[]
  identities            UserIdentity[]
  refreshSessions       RefreshSession[]
  passwordResetTokens   PasswordResetToken[]     @relation("PasswordResetUser")
  issuedPasswordResets  PasswordResetToken[]     @relation("PasswordResetCreatedBy")
  authAttempts          AuthAttempt[]
  deviceTokens          DeviceToken[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  auditLogs             AuditLog[]
  taskAssignments       TaskAssignment[]
  taskEvents            TaskEvent[]
  taskComments          TaskComment[]
  createdTasks          Task[]                   @relation("TaskCreatedBy")
  assignedTasks         Task[]                   @relation("TaskAssignee")
  odometerReadings      OdometerReading[]
  grantedRolePerms      RolePermission[]         @relation("RolePermissionGrantedBy")
  grantedUserRole       UserRole[]               @relation("UserRoleAssignedBy")
  idempotencyKeys       IdempotencyKey[]
  exportJobs            ExportJob[]
  attachments           Attachment[]
  scheduledReminderAcks ScheduledReminder[]      @relation("ReminderAcknowledgedBy")
  // SQL: partial unique index umjesto @@unique (Prisma ne podržava partial):
  //   DROP INDEX IF EXISTS "User_email_key";
  //   CREATE UNIQUE INDEX IF NOT EXISTS ux_user_email_active
  //     ON "User"(email) WHERE "deletedAt" IS NULL;
  // SQL: trigger `vfm_guard_last_super_admin()` (docs/03 §3.2) — sprječava
  //   deaktivaciju/brisanje posljednjeg aktivnog SUPER_ADMIN korisnika.
  // SQL: 2FA kolone NE postoje (R-05 — 2FA se ne implementira).

  @@unique([email])
  @@index([status])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("User")
}

model Role {
  id                 String       @id @db.Uuid
  code               String       @unique
  name               String
  description        String?
  isSystem           Boolean      @default(false)
  allowedClientTypes ClientType[] @default([WEB, MOBILE_ANDROID])
  permissionsVersion Int          @default(0)
  priority           Int          @default(100)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?    @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]
  // SQL: SUPER_ADMIN.allowedClientTypes = {WEB} (seed + provjera u aplikaciji).
  // SQL: bump `permissionsVersion` pri svakoj izmjeni prava → invalidira keš
  //      `vfm:permver:*` (docs/05 §1).

  @@map("Role")
}

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique
  module      String
  action      String
  description String?
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]
  // Seed: packages/shared/src/permissions.ts → PERMISSION_CATALOG (jedan izvor).

  @@unique([module, action])
  @@index([module])
  @@map("Permission")
}

model RolePermission {
  id              String          @id @db.Uuid
  roleId          String          @db.Uuid
  permissionId    String          @db.Uuid
  scope           PermissionScope @default(ALL)
  scopeVehicleIds String[]        @db.Uuid
  scopeDriverIds  String[]        @db.Uuid
  conditions      Json?
  grantedById     String?         @db.Uuid
  grantedAt       DateTime        @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantedBy", fields: [grantedById], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("RolePermission")
}

model UserRole {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  assignedById String?   @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamptz(6)
  note         String?
  validFrom    DateTime? @db.Timestamptz(6)
  validUntil   DateTime? @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id])
  // SQL: trigger koji odbija revokaciju SUPER_ADMIN role posljednjem aktivnom
  //      Super Adminu (docs/03 §3.2).

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("UserRole")
}

model UserIdentity {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  driverId  String   @db.Uuid
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([userId, driverId])
  @@index([driverId])
  @@map("UserIdentity")
}

model RefreshSession {
  id           String     @id @db.Uuid
  userId       String     @db.Uuid
  tokenHash    String     @unique
  familyId     String     @db.Uuid
  clientType   ClientType
  deviceInfo   Json?
  ipAddress    String?    @db.Inet
  userAgent    String?
  expiresAt    DateTime   @db.Timestamptz(6)
  revokedAt    DateTime?  @db.Timestamptz(6)
  replacedById String?    @db.Uuid
  lastUsedAt   DateTime?  @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Rotacija + reuse detection: `familyId` povezuje lanac tokena; ponovna
  // upotreba iskorištenog tokena → revokacija cijele porodice (docs/05 §5.2).

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("RefreshSession")
}

model AuthAttempt {
  id            String     @id @db.Uuid
  email         String
  userId        String?    @db.Uuid
  success       Boolean
  clientType    ClientType
  ipAddress     String?    @db.Inet
  userAgent     String?
  failureReason String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Retencija: 180 dana (maintenance job, docs/03 §6).

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("AuthAttempt")
}

/// Jednokratni token za reset lozinke (Faza 1, chunk J).
///
/// Bez ovog modela reset lozinke bi morao nositi lozinku u e-mailu ili je
/// vraćati u odgovoru API-ja — oboje je nedopustivo. Token se **nikad ne čuva
/// u čistom obliku**: u bazi je `tokenHash` (SHA-256), važi 30 minuta i može se
/// iskoristiti samo jednom (`usedAt`). Novi reset za istog korisnika invalidira
/// prethodne tokene (upis `usedAt`), pa stari link ne može ostati aktivan.
model PasswordResetToken {
  id          String    @id @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  /// IP s kojeg je token zatražen (forenzika, `AuditLog` nosi isti podatak).
  ipAddress   String?   @db.Inet

  user      User  @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PasswordResetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Retencija: istekli tokeni se brišu maintenance jobom (docs/03 §6).
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("PasswordResetToken")
}

// -----------------------------------------------------------------------------
//  3.3 Vozila i evidencije
// -----------------------------------------------------------------------------

model Vehicle {
  id                    String        @id @db.Uuid
  internalNo            String
  make                  String
  model                 String
  year                  Int?
  vin                   String?
  plateNumber           String?
  fuelType              FuelType
  transmission          String?
  color                 String?
  bodyType              String?
  engineCcm             Int?
  enginePowerKw         Int?
  seats                 Int?
  ownershipType         String        @default("OWNED")
  acquisitionDate       DateTime?     @db.Date
  acquisitionPrice      Int?
  costCenter            String?
  odometerKm            Int           @default(0)
  odometerUpdatedAt     DateTime?     @db.Timestamptz(6)
  status                VehicleStatus @default(ACTIVE)
  registrationExpiresAt DateTime?     @db.Date
  insuranceExpiresAt    DateTime?     @db.Date
  nextServiceDueDate    DateTime?     @db.Date
  nextServiceDueKm      Int?
  photoAttachmentId     String?       @unique @db.Uuid
  notes                 String?
  formSchemaId          String        @db.Uuid
  formSchemaVersionId   String        @db.Uuid
  formData              Json          @default("{}")
  version               Int           @default(0)
  createdById           String?       @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?     @db.Timestamptz(6)
  archivedAt            DateTime?     @db.Timestamptz(6)

  formSchema        FormSchema           @relation(fields: [formSchemaId], references: [id])
  formSchemaVersion FormSchemaVersion    @relation(fields: [formSchemaVersionId], references: [id])
  // 1:1 → `photoAttachmentId` mora biti UNIQUE (isti attachment ne može biti
  // naslovna fotografija dva vozila; NULL je dozvoljen više puta).
  photoAttachment   Attachment?          @relation("VehiclePhoto", fields: [photoAttachmentId], references: [id])
  odometerReadings  OdometerReading[]
  registrations     RegistrationRecord[]
  insurances        InsuranceRecord[]
  services          ServiceRecord[]
  tasks             Task[]
  tireInstallations TireInstallation[]
  // SQL: partial unique na internalNo (WHERE "deletedAt" IS NULL);
  //      unique na vin (WHERE vin IS NOT NULL AND "deletedAt" IS NULL);
  //      CHECK (odometerKm >= 0), CHECK (year BETWEEN 1950 AND 2100),
  //      CHECK (vin IS NULL OR length(vin) = 17).

  @@unique([internalNo])
  @@index([status])
  @@index([registrationExpiresAt])
  @@index([insuranceExpiresAt])
  @@index([nextServiceDueDate])
  @@index([make, model])
  @@index([plateNumber])
  @@index([deletedAt])
  @@map("Vehicle")
}

model OdometerReading {
  id               String         @id @db.Uuid
  vehicleId        String         @db.Uuid
  valueKm          Int
  source           OdometerSource @default(MANUAL)
  referenceType    String?
  referenceId      String?        @db.Uuid
  readingAt        DateTime       @db.Timestamptz(6)
  recordedById     String?        @db.Uuid
  isCorrection     Boolean        @default(false)
  correctionReason String?
  previousValueKm  Int?
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation(fields: [recordedById], references: [id])
  // SQL: CHECK (valueKm >= 0). Pravilo regresije: nova vrijednost < max →
  //      422 ODOMETER_REGRESSION, osim isCorrection=true + correctionReason.

  @@unique([vehicleId, readingAt, valueKm, source])
  @@index([vehicleId, readingAt(sort: Desc)])
  @@map("OdometerReading")
}

model RegistrationRecord {
  id                  String       @id @db.Uuid
  vehicleId           String       @db.Uuid
  formSchemaId        String       @db.Uuid
  formSchemaVersionId String       @db.Uuid
  formData            Json         @default("{}")
  registrationNumber  String
  validFrom           DateTime     @db.Date
  validUntil          DateTime     @db.Date
  issuedBy            String?
  costAmount          Int?
  currency            String       @default("BAM") @db.Char(3)
  attachmentIds       String[]     @db.Uuid
  status              RecordStatus @default(ACTIVE)
  notes               String?
  version             Int          @default(0)
  createdById         String?      @db.Uuid
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?    @db.Timestamptz(6)

  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  formSchema        FormSchema        @relation(fields: [formSchemaId], references: [id])
  formSchemaVersion FormSchemaVersion @relation(fields: [formSchemaVersionId], references: [id])
  // SQL: CHECK (validUntil > validFrom);
  //      EXCLUDE USING gist ("vehicleId" WITH =, daterange(validFrom,validUntil,'[]') WITH &&)
  //        WHERE ("deletedAt" IS NULL)   → B-10 (bez preklapanja perioda);
  //      zahtijeva ekstenziju btree_gist.

  @@index([vehicleId, validUntil(sort: Desc)])
  @@index([validUntil])
  @@map("RegistrationRecord")
}

model InsuranceRecord {
  id                  String       @id @db.Uuid
  vehicleId           String       @db.Uuid
  formSchemaId        String       @db.Uuid
  formSchemaVersionId String       @db.Uuid
  formData            Json         @default("{}")
  policyNumber        String?
  insuranceCompany    String?
  type                String?
  validFrom           DateTime     @db.Date
  validUntil          DateTime     @db.Date
  premiumAmount       Int?
  currency            String       @default("BAM") @db.Char(3)
  deductibleAmount    Int?
  attachmentIds       String[]     @db.Uuid
  status              RecordStatus @default(ACTIVE)
  notes               String?
  version             Int          @default(0)
  createdById         String?      @db.Uuid
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?    @db.Timestamptz(6)

  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  formSchema        FormSchema        @relation(fields: [formSchemaId], references: [id])
  formSchemaVersion FormSchemaVersion @relation(fields: [formSchemaVersionId], references: [id])
  // SQL: CHECK + EXCLUDE kao kod RegistrationRecord.

  @@index([vehicleId, validUntil(sort: Desc)])
  @@index([validUntil])
  @@map("InsuranceRecord")
}

model ServiceRecord {
  id                  String       @id @db.Uuid
  vehicleId           String       @db.Uuid
  formSchemaId        String       @db.Uuid
  formSchemaVersionId String       @db.Uuid
  formData            Json         @default("{}")
  serviceDate         DateTime     @db.Date
  odometerKm          Int?
  serviceType         String
  workshopId          String?      @db.Uuid
  workshopName        String?
  description         String?
  partsReplaced       String?
  laborCost           Int?
  partsCost           Int?
  totalCost           Int
  currency            String       @default("BAM") @db.Char(3)
  nextServiceDueDate  DateTime?    @db.Date
  nextServiceDueKm    Int?
  invoiceNumber       String?
  attachmentIds       String[]     @db.Uuid
  status              RecordStatus @default(ACTIVE)
  notes               String?
  version             Int          @default(0)
  createdById         String?      @db.Uuid
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?    @db.Timestamptz(6)

  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  formSchema        FormSchema        @relation(fields: [formSchemaId], references: [id])
  formSchemaVersion FormSchemaVersion @relation(fields: [formSchemaVersionId], references: [id])
  workshop          ListItem?         @relation(fields: [workshopId], references: [id])
  items             ServiceItem[]
  // SQL: CHECK (totalCost >= 0); CHECK (odometerKm IS NULL OR odometerKm >= 0).

  @@index([vehicleId, serviceDate(sort: Desc)])
  @@index([nextServiceDueDate])
  @@index([serviceType])
  @@map("ServiceRecord")
}

model ServiceItem {
  id              String  @id @db.Uuid
  serviceRecordId String  @db.Uuid
  kind            String  @default("OTHER")
  name            String
  quantity        Decimal @default(1.00) @db.Decimal(10, 2)
  unitPrice       Int?
  totalPrice      Int
  partNumber      String?
  notes           String?
  position        Int     @default(0)

  serviceRecord ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  // SQL: CHECK (kind IN ('PART','LABOR','FLUID','OTHER')).

  @@index([serviceRecordId])
  @@map("ServiceItem")
}

model Driver {
  id                      String    @id @db.Uuid
  firstName               String
  lastName                String
  phone                   String?
  email                   String?   @db.Citext
  dateOfBirth             DateTime? @db.Date
  address                 String?
  employeeNumber          String?
  employmentStatus        String?
  licenseNumber           String?
  licenseIssuedAt         DateTime? @db.Date
  licenseExpiresAt        DateTime? @db.Date
  licenseIssuingAuthority String?
  restrictions            String?
  notes                   String?
  status                  String    @default("ACTIVE")
  photoAttachmentId       String?   @unique @db.Uuid
  formSchemaId            String?   @db.Uuid
  formSchemaVersionId     String?   @db.Uuid
  formData                Json      @default("{}")
  version                 Int       @default(0)
  createdById             String?   @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime? @db.Timestamptz(6)

  photoAttachment   Attachment?             @relation("DriverPhoto", fields: [photoAttachmentId], references: [id])
  formSchema        FormSchema?             @relation(fields: [formSchemaId], references: [id])
  formSchemaVersion FormSchemaVersion?      @relation(fields: [formSchemaVersionId], references: [id])
  categories        DriverLicenseCategory[]
  identities        UserIdentity[]
  // PII (B-20): licenseNumber, dateOfBirth, address, phone, email se vraćaju
  //   samo uz `driver:view_pii`; Super Admin ih vidi uvijek (R-07).

  @@index([lastName, firstName])
  @@index([licenseExpiresAt])
  @@index([deletedAt])
  @@map("Driver")
}

model DriverLicenseCategory {
  id           String    @id @db.Uuid
  driverId     String    @db.Uuid
  category     String
  issuedAt     DateTime? @db.Date
  expiresAt    DateTime? @db.Date
  restrictions String?
  notes        String?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, category])
  @@index([expiresAt])
  @@map("DriverLicenseCategory")
}

