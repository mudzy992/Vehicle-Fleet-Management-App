# =============================================================================
#  VFM Web — nginx (SPA + API proxy)
#  ${WEB_API_INTERNAL_URL} se zamjenjuje pri startu kontejnera (envsubst),
#  kontrolisano preko NGINX_ENVSUBST_FILTER=WEB_API_INTERNAL_URL tako da se
#  nginx varijable ($host, $uri) NE diraju.
# =============================================================================

server {
    listen       80;
    listen  [::]:80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # -------------------------------------------------------------------------
    # Osnovna higijena
    # -------------------------------------------------------------------------
    client_max_body_size 25m;          # usklađeno s BODY_LIMIT_MULTIPART
    server_tokens off;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/xml application/json application/javascript
        application/xml+rss application/rss+xml image/svg+xml font/woff2;

    # -------------------------------------------------------------------------
    # Healthcheck (Coolify + docker healthcheck) — bez logova
    # -------------------------------------------------------------------------
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # -------------------------------------------------------------------------
    # API proxy → NestJS (isti origin ⇒ bez CORS-a, cookie radi)
    # -------------------------------------------------------------------------
    location /api/ {
        proxy_pass         ${WEB_API_INTERNAL_URL};
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Request-ID      $request_id;

        # SSE (stream obavijesti) — bez bufferinga i bez timeouta
        proxy_buffering           off;
        proxy_cache               off;
        proxy_set_header          Connection '';
        chunked_transfer_encoding off;
        proxy_read_timeout        3600s;
        proxy_send_timeout        3600s;

        # Upload priloga
        proxy_request_buffering   off;
    }

    # Zdravlje API-ja kroz proxy (radi debug-a)
    location = /health {
        proxy_pass ${WEB_API_INTERNAL_URL}/health/live;
        access_log off;
    }

    # -------------------------------------------------------------------------
    # Sigurnosni headeri
    # -------------------------------------------------------------------------
    add_header X-Frame-Options           "SAMEORIGIN"        always;
    add_header X-Content-Type-Options    "nosniff"           always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(), microphone=(), camera=(self)" always;
    add_header Cross-Origin-Opener-Policy "same-origin"      always;
    add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # -------------------------------------------------------------------------
    # Statički asseti s hashom u imenu → dugi cache
    # -------------------------------------------------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Ostali statički fajlovi (favicon, ikone, fontovi)
    location ~* \.(?:ico|png|jpg|jpeg|gif|webp|svg|woff2?|ttf|eot|webmanifest)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
        try_files $uri =404;
    }

    # -------------------------------------------------------------------------
    # SPA fallback — index.html se NE kešira (deploym odmah vidljivi)
    # -------------------------------------------------------------------------
    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        expires -1;
        try_files $uri $uri/ /index.html;
    }

    # -------------------------------------------------------------------------
    # Skrivanje dot-fajlova i source map-a u produkciji
    # -------------------------------------------------------------------------
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
