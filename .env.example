# =============================================================================
#  VOZNI PARK (VFM) — .env.example
# =============================================================================
#  Jedini izvor istine za sve varijable okruženja.
#
#  PRAVILA
#  1) Ovaj fajl NE sadrži stvarne tajne. U repozitorij ide SAMO .env.example.
#  2) Lokalno:  cp .env.example .env   (`.env` je u .gitignore)
#  3) Coolify:  sve varijable ispod unijeti u  Resource → Environment Variables.
#     Vrijednosti označene sa ":?" u docker-compose.yml su OBAVEZNE — Coolify
#     neće dozvoliti deploy dok su prazne.
#  4) Svaka nova varijabla u kodu/compose-u MORA biti dodana ovdje u istom
#     commit-u (CI job `env-sync-check` to i provjerava).
#  5) Prefix aplikacije je `vfm`. Redis mreža: `redis_net`. Postgres mreža: `db_net`.
#
#  Generisanje tajni:
#     node scripts/gen-secrets.mjs          (sve odjednom)
#     openssl rand -base64 48               (pojedinačno)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. OPĆE / APLIKACIJA
# -----------------------------------------------------------------------------
# production | staging | development
APP_ENV=production
APP_NAME="Vozni park"
APP_VERSION=1.0.0
# Prefix svih resursa (kontejneri, Redis ključevi, queue-ovi, ACL useri)
APP_PREFIX=vfm
# IANA vremenska zona za prikaz i za raspored podsjetnika (DB čuva UTC)
APP_TIMEZONE=Europe/Sarajevo
# Jezik aplikacije i format datuma/brojeva
APP_LOCALE=bs
APP_DEFAULT_CURRENCY=BAM
LOG_LEVEL=info
# JSON format logova (pino) — u dev može "pretty"
LOG_FORMAT=json
# Node okruženje za kontejnere
NODE_ENV=production
# Profil env validatora: "api" (puna provjera), "tool" (migrate/CLI — preskače
# API-only varijable poput JWT/CORS/COOKIE), "test"
ENV_PROFILE=api


# -----------------------------------------------------------------------------
# 2. API SERVER
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# Javna HTTPS adresa API-ja (koristi se za CORS, linkove u e-mailovima, Swagger)
# Coolify: ostaviti prazno i koristiti SERVICE_URL_API_3000 magic varijablu,
# ili upisati punu domenu, npr. https://api.voznipark.example.ba
PUBLIC_API_URL=
# Osnovni put API-ja
API_PREFIX=/api/v1
# Swagger/OpenAPI — U PRODUKCIJI MORA BITI false
SWAGGER_ENABLED=false
SWAGGER_PATH=/api/v1/docs
# Zdravlje
HEALTH_PATH=/health
# Veličina tijela zahtjeva (JSON) i multipart limita
BODY_LIMIT_JSON=1mb
BODY_LIMIT_MULTIPART=25mb
# Koliko instanci API-ja (Coolify/Compose scale) — za sada 1
API_REPLICAS=1
# Graceful shutdown (ms) — BullMQ i HTTP drain
SHUTDOWN_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# 3. CORS / SIGURNOST ZAHTJEVA
# -----------------------------------------------------------------------------
# Zarezom odvojena allowlista origin-a (bez trailing slash).
# Uključiti: web domenu, preview domene (ako postoje) i mobilni origin ako treba.
CORS_ORIGINS=https://voznipark.example.ba
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true
# Pouzdanost proxy headera (Coolify Traefik) — "loopback" ili "all"
TRUST_PROXY=loopback
# Helmet Content-Security-Policy za API odgovore
API_CSP_ENABLED=true


# -----------------------------------------------------------------------------
# 4. RATE LIMITING (Redis)
# -----------------------------------------------------------------------------
THROTTLE_ENABLED=true
# Globalno: broj zahtjeva po prozoru po korisniku/IP-u
THROTTLE_GLOBAL_TTL_SECONDS=60
THROTTLE_GLOBAL_LIMIT=300
# Login endpoint (zaštita od brute force)
THROTTLE_LOGIN_TTL_SECONDS=900
THROTTLE_LOGIN_LIMIT=5
# Upload priloga
THROTTLE_UPLOAD_TTL_SECONDS=60
THROTTLE_UPLOAD_LIMIT=30
# Nakon koliko neuspjelih prijava se nalog zaključava i na koliko minuta
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15


# -----------------------------------------------------------------------------
# 5. POSTGRESQL  (Coolify resurs, mreža: db_net)
# -----------------------------------------------------------------------------
# ⚠️ HOST MORA BITI PUNI COOLIFY NAZIV KONTJENERA (npr. postgres-a1b2c3d4e5f6),
#    NE "postgres" i NE "localhost". Coolify preimenuje servise radi izbjegavanja
#    DNS kolizija na dijeljenoj mreži. Naziv naći u Coolify → PostgreSQL → General.
DATABASE_HOST=postgres-XXXXXXXXXXXX
DATABASE_PORT=5432
DATABASE_NAME=vfm
DATABASE_USER=vfm
# Tajna — postaviti u Coolify (obavezno, `:?`)
DATABASE_PASSWORD=
DATABASE_SSL=false
# Prisma connection string (sestavlja se u compose-u iz gornjih vrijednosti;
# ako je želite upravljati ručno, popunite ovo i ostavite DATABASE_* prazne)
# Format: postgresql://USER:PASS@HOST:PORT/DB?schema=public&connection_limit=10&pool_timeout=20
DATABASE_URL=
# Veličina Prisma pool-a
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=20
# Naziv Docker mreže za bazu (external) — ne mijenjati bez dogovora
DB_NETWORK=db_net


# -----------------------------------------------------------------------------
# 6. REDIS  (Coolify resurs, mreža: redis_net, ACL prefix: vfm)
# -----------------------------------------------------------------------------
# ⚠️ Isto kao za DB: puni Coolify naziv kontejnera (npr. redis-a1b2c3d4e5f6).
REDIS_HOST=redis-XXXXXXXXXXXX
REDIS_PORT=6379
REDIS_TLS=false
# ACL useri iz REDIS_ACL.md — svaki servis koristi SVOG usera (least privilege)
REDIS_USER_API=vfm-api
REDIS_PASSWORD_API=
REDIS_USER_WORKER=vfm-worker
REDIS_PASSWORD_WORKER=
REDIS_USER_READONLY=vfm-readonly
REDIS_PASSWORD_READONLY=
# DB indeks (ACL ključevi su već odvojeni prefixom `vfm:`, pa 0 je u redu)
REDIS_DB=0
# Naziv Docker mreže za Redis (external)
REDIS_NETWORK=redis_net
# ⚠️ Ako promijenite bilo koji REDIS_* ključ/prefix u kodu ili nove queue-ove,
#    OBAVEZNO ažurirajte REDIS_ACL.md i ACL fajl na Coolify Redis resursu.
VFM_REDIS_KEY_PREFIX=vfm:


# -----------------------------------------------------------------------------
# 7. BULLMQ / WORKER
# -----------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY_OUTBOX=5
WORKER_CONCURRENCY_NOTIFICATIONS=10
WORKER_CONCURRENCY_REMINDERS=2
WORKER_CONCURRENCY_REPORTS=2
# Nazivi queue-ova (Redis ključevi: vfm:queue:<naziv>:*)
QUEUE_OUTBOX=vfm-queue-outbox
QUEUE_NOTIFICATIONS=vfm-queue-notifications
QUEUE_REMINDERS=vfm-queue-reminders
QUEUE_REPORTS=vfm-queue-reports
QUEUE_MAINTENANCE=vfm-queue-maintenance
# Retry politika
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_TYPE=exponential
QUEUE_BACKOFF_DELAY_MS=5000
# Koliko dugo se čuvaju završeni/neuspješni jobovi (ms)
QUEUE_REMOVE_ON_COMPLETE_MS=86400000
QUEUE_REMOVE_ON_FAIL_MS=604800000
# Outbox: koliko često worker ponovo skenira zaglavljene događaje (ms)
OUTBOX_POLL_INTERVAL_MS=30000
OUTBOX_BATCH_SIZE=50
# Nakon koliko pokušaja outbox događaj ide u DEAD (ne blokira posao)
OUTBOX_MAX_ATTEMPTS=8
# DLQ alarm prag (monitoring)
OUTBOX_DEAD_ALERT_THRESHOLD=1


# -----------------------------------------------------------------------------
# 8. JWT / SESIJE / KOLAČIĆI
# -----------------------------------------------------------------------------
# OBAVEZNE tajne — generisati sa `openssl rand -base64 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=30d
JWT_ISSUER=vfm-api
JWT_AUDIENCE=vfm-clients
# Web (httpOnly cookie za refresh token)
COOKIE_NAME=vfm_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_PATH=/api/v1/auth
# Potpis za signed URL-ove priloga (HMAC SHA-256)
FILE_SIGNING_SECRET=
FILE_SIGNED_URL_TTL_SECONDS=300
# Koliko često se provjerava `permissionsVersion` (cache TTL u sekundama)
PERMISSIONS_CACHE_TTL_SECONDS=60
# Maksimalan broj aktivnih refresh sesija po korisniku
AUTH_MAX_SESSIONS_PER_USER=5


# -----------------------------------------------------------------------------
# 9. BOOTSTRAP PRVOG SUPER ADMINA
# -----------------------------------------------------------------------------
# Koristi se SAMO pri prvom pokretanju (scripts/bootstrap-super-admin.mjs /
# seed). Lozinka se NE upisuje ovdje u produkciji — skripta generiše slučajnu
# lozinku i ispiše je jednom u log, te traži promjenu pri prvoj prijavi.
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin
# Ostaviti PRAZNO da skripta generiše slučajnu lozinku (preporučeno)
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Ime demo korisnika (samo dev/staging seed)
SEED_DEMO_DATA=false


# -----------------------------------------------------------------------------
# 10. FIREBASE CLOUD MESSAGING (push)
# -----------------------------------------------------------------------------
# ⚠️ service account JSON je TAJNA i dostupan je SAMO api/worker kontejneru
#    preko file mount-a. NIKAD ga ne stavljati u web ili mobilni bundle, niti
#    u repozitorij. Na Coolify: mount iz host puta ili secret volume.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Apsolutni put u kontejneru do montiranog fajla
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/vfm/firebase-service-account.json
# Put na HOSTU gdje se fajl nalazi (bind mount izvor)
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/etc/vfm/secrets/firebase-service-account.json
# Android paket mobilne aplikacije (provjera primaoca)
FCM_ANDROID_PACKAGE=ba.example.voznipark
# TTL push poruke ako uređaj nije online (sekunde) — 24 h
FCM_MESSAGE_TTL_SECONDS=86400
# Koliko uzastopnih grešaka prije nego token označimo nevažećim
FCM_INVALID_TOKEN_THRESHOLD=1


# -----------------------------------------------------------------------------
# 11. POHRANA PRILOGA  (host bind-mount → /data/vfm u kontejneru)
# -----------------------------------------------------------------------------
# ⚠️ Putanja NA HOSTU koju Docker mapira u kontejner.
#    Coolify: relativne putanje se rješavaju od direktorija resursa; za
#    apsolutnu host putanju koristiti npr. /data/vfm/attachments.
VFM_STORAGE_PATH=/data/vfm/attachments
# Putanja u kontejneru (ne mijenjati bez izmjene Dockerfile/compose)
VFM_STORAGE_CONTAINER_PATH=/data/vfm/attachments
# Dozvoljeni tipovi i veličine
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/heic,application/pdf
# Provjera stvarnog sadržaja (magic bytes), ne samo Content-Type headera
ATTACHMENT_VALIDATE_MAGIC_BYTES=true
# Kompresija/resize fotografija prije spremanja (0 = isključeno)
ATTACHMENT_IMAGE_MAX_WIDTH=1920
ATTACHMENT_IMAGE_JPEG_QUALITY=82
# Privremeni direktorij za upload (mora biti na istom filesystemu kao storage)
ATTACHMENT_TEMP_PATH=/data/vfm/tmp


# -----------------------------------------------------------------------------
# 12. WEB FRONTEND (nginx kontejner)
# -----------------------------------------------------------------------------
# Interna adresa API-ja unutar compose mreže (nginx /api proxy)
WEB_API_INTERNAL_URL=http://api:3000
# Javna adresa API-ja koju browser koristi (ako se NE proxy-uje kroz nginx)
VITE_PUBLIC_API_URL=
# Naslov i brendiranje
VITE_APP_TITLE="Vozni park"
VITE_APP_ENV=production
# Sentry / error reporting (opciono)
VITE_SENTRY_DSN=
# Verzija (ubacuje se pri build-u)
VITE_APP_VERSION=1.0.0


# -----------------------------------------------------------------------------
# 13. MOBILNA APLIKACIJA (Expo / EAS) — NIJE dio Docker stacka
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.voznipark.example.ba/api/v1
EXPO_PUBLIC_APP_ENV=production
EAS_PROJECT_ID=
ANDROID_PACKAGE=ba.example.voznipark
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0
# Google services (FCM klijent) — fajl `google-services.json` NE ide u repo
GOOGLE_SERVICES_JSON_PATH=./apps/mobile/google-services.json


# -----------------------------------------------------------------------------
# 14. PODSJETNICI (registracija, osiguranje, servis, dozvola)
# -----------------------------------------------------------------------------
REMINDERS_ENABLED=true
# Vrijeme skeniranja u APP_TIMEZONE (24h)
REMINDERS_SCHEDULE_CRON=0 6 * * *
# Default pragovi u danima (Super Admin ih može mijenjati kroz Postavke)
REMINDER_REGISTRATION_DAYS_BEFORE=5
REMINDER_INSURANCE_DAYS_BEFORE=5
REMINDER_SERVICE_DAYS_BEFORE=7
REMINDER_SERVICE_KM_BEFORE=500
REMINDER_DRIVER_LICENSE_DAYS_BEFORE=30
REMINDER_TECHNICAL_INSPECTION_DAYS_BEFORE=10
# Koliko dugo se podsjetnik ponavlja ako nije riješen (dana, 0 = jednom)
REMINDER_REPEAT_DAYS=0
# Primaoci po defaultu (permisija koja određuje ko dobija)
REMINDER_RECIPIENTS_PERMISSION=vehicle:view


# -----------------------------------------------------------------------------
# 15. IZVJEŠTAJI I IZVOZ
# -----------------------------------------------------------------------------
REPORTS_ENABLED=true
# Maksimalan broj redova za sinhroni izvoz; iznad toga ide kroz worker job
REPORT_EXPORT_SYNC_MAX_ROWS=5000
REPORT_EXPORT_FORMATS=pdf,xlsx
REPORT_EXPORT_RETENTION_DAYS=7
# Direktorij izvoza (unutar storage mount-a)
REPORT_EXPORT_PATH=/data/vfm/attachments/exports


# -----------------------------------------------------------------------------
# 16. AUDIT I SIGURNOSNI DOGAĐAJI
# -----------------------------------------------------------------------------
AUDIT_ENABLED=true
# Zadržavanje audit zapisa u danima (0 = trajno)
AUDIT_RETENTION_DAYS=0
# Redigovanje osjetljivih polja u logovima i audit diff-u
AUDIT_REDACT_FIELDS=password,passwordHash,token,refreshToken,authorization,cookie,jti,firebaseServiceAccount
# Bilježenje IP adrese i User-Agent-a (GDPR: interno opravdano)
AUDIT_CAPTURE_IP=true


# -----------------------------------------------------------------------------
# 17. MONITORING / METRIKE
# -----------------------------------------------------------------------------
METRICS_ENABLED=false
METRICS_PATH=/metrics
# Pragovi za interne alarme (log warning + outbox)
ALERT_DISK_USAGE_PERCENT=85
ALERT_QUEUE_DEPTH=100
# Uptime provjera (opciono, eksterni servis)
UPTIME_HEARTBEAT_URL=


# -----------------------------------------------------------------------------
# 18. COOLIFY MAGIC VARIJABLE (popuniti/ostaviti Coolify-u)
# -----------------------------------------------------------------------------
# Coolify generiše domenu za servis `api` na portu 3000:
#   SERVICE_URL_API_3000=/            (ili /api/v1 ako želite path)
#   SERVICE_FQDN_API_3000
# i domenu za `web`:
#   SERVICE_URL_WEB=/
# Ove varijable NE upisujete ručno — Coolify ih kreira pri load-u compose-a.
SERVICE_URL_API_3000=/
SERVICE_URL_WEB=/
# Coolify "Connect to Predefined Network" mreža (destination)
COOLIFY_NETWORK=coolify
# Da li su db_net / redis_net eksterni (true na Coolify/produkcijskom hostu)
DB_NET_EXTERNAL=true
REDIS_NET_EXTERNAL=true
# Naziv host direktorija resursa (Coolify "Preserve repository during deployment")
COOLIFY_BASE_DIRECTORY=/


# -----------------------------------------------------------------------------
# 18b. DOCKER BUILD / COMPOSE / RESURSI
# -----------------------------------------------------------------------------
# Nazivi image-a (Coolify ih generiše; lokalno ostaviti default)
VFM_API_IMAGE=vfm-api:local
VFM_WEB_IMAGE=vfm-web:local
# Naziv interne (Coolify/default) mreže stacka
COMPOSE_NETWORK_NAME=vfm_default
# Memorijski limiti kontejnera (Compose `deploy.resources.limits.memory`)
API_MEMORY_LIMIT=1024M
WORKER_MEMORY_LIMIT=768M
WEB_MEMORY_LIMIT=128M
# CPU limiti (koristi se samo u docker-compose.coolify.yml hardening override-u)
API_CPU_LIMIT=1.5
WORKER_CPU_LIMIT=1.0
WEB_CPU_LIMIT=0.5
# Turborepo remote cache (opciono — ubrzava Docker build i CI)
TURBO_TEAM=
TURBO_TOKEN=
# Da li `migrate` servis pokreće i seed (dev/staging: true, produkcija: false)
RUN_DB_SEED=false


# -----------------------------------------------------------------------------
# 19. RAZVOJ / TEST (nije potrebno u produkciji)
# -----------------------------------------------------------------------------
# Dev kredencijali — SAMO za lokalni docker-compose.dev.yml.
# NIKAD ih ne koristiti u produkciji i nikad ne commitovati stvarne vrijednosti.
DEV_DB_PASSWORD=vfm_dev_only
DEV_REDIS_PASSWORD_API=vfm_dev_only
DEV_REDIS_PASSWORD_WORKER=vfm_dev_only
DEV_REDIS_PASSWORD_READONLY=vfm_dev_only
# Test baza (testcontainers ili lokalni dev compose)
TEST_DATABASE_URL=postgresql://vfm:vfm@localhost:5433/vfm_test?schema=public
TEST_REDIS_URL=redis://vfm-api@localhost:6380/0
# Dev override za compose (docker-compose.dev.yml)
DEV_POSTGRES_PORT=5433
DEV_REDIS_PORT=6380
DEV_STORAGE_PATH=./.data/attachments


# =============================================================================
#  CHANGELOG .env.example  (ažurirati pri SVAKOJ izmjeni!)
# =============================================================================
#  1.0.0 | 19.10.2026. | Inicijalna verzija: aplikacija, API, CORS, throttling,
#                        PostgreSQL (db_net), Redis ACL (redis_net, prefix vfm),
#                        BullMQ/worker, JWT/sesije, bootstrap Super Admin,
#                        Firebase/FCM, host storage za priloge, web (nginx),
#                        mobilna (Expo/EAS), podsjetnici, izvještaji, audit,
#                        metrike, Coolify magic varijable, dev/test.
#  1.0.1 | 19.10.2026. | Dodato: ENV_PROFILE (api/tool/test) — koristi ga
#                        `migrate` servis; API_MEMORY_LIMIT, WORKER_MEMORY_LIMIT,
#                        WEB_MEMORY_LIMIT, *_CPU_LIMIT, COMPOSE_NETWORK_NAME,
#                        VFM_API_IMAGE, VFM_WEB_IMAGE, TURBO_TEAM/TURBO_TOKEN,
#                        RUN_DB_SEED, DEV_* kredencijali za docker-compose.dev.yml.
#
#  ⚠️  SYNC OBAVEZE
#  - Novi servis u docker-compose.yml  → dodati njegove varijable ovdje.
#  - Novi Redis ključ/queue/prefix     → ažurirati REDIS_ACL.md (i ACL fajl!).
#  - Novi secret                       → dodati u .env.example + Coolify ENV.
# =============================================================================
