{
  "name": "vehicle-fleet-management-app",
  "version": "1.0.0",
  "private": true,
  "description": "Vozni park (VFM) — sistem za upravljanje službenim voznim parkom",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "env:check": "node scripts/env-sync-check.mjs",
    "env:check:strict": "node scripts/env-sync-check.mjs --strict",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm --filter @vfm/api exec prisma generate",
    "prisma:migrate:deploy": "pnpm --filter @vfm/api exec prisma migrate deploy",
    "prisma:migrate:dev": "pnpm --filter @vfm/api exec prisma migrate dev",
    "secrets:gen": "node scripts/gen-secrets.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.4.0",
      "multer": "2.5.0"
    }
  }
}
